{
  "tasks": {
    "dev": "deno run -A --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "start": "deno run -A main.ts",
    "vite:routes": "deno run -A npm:vite@^8.0.0 --config vite.config.ts build --ssr vite-routes-smoke.ts --outDir .vite-limette-smoke",
    "vite:client": "deno run -A npm:vite@^8.0.0 --config vite.config.ts build --outDir .vite-limette-client",
    "vite:assets": "deno run -A vite-assets-smoke.ts",
    "vite:ssr": "deno run -A vite-ssr-smoke.ts",
    "vite:server": "deno run -A vite-server-smoke.ts"
  },
  "imports": {
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@0.1.49",
    "@limette/core": "jsr:@limette/core@0.2.3",
    "@limette/core/dev": "../src/dev/mod.ts",
    "@limette/core/vite": "../src/vite/mod.ts",
    "@limette/core/runtime": "../src/runtime/mod.ts",
    "@limette/core/runtime/refresh.ts": "../src/runtime/refresh.ts",
    "@limette/core/runtime/ssr-client/lit-element-hydrate-support.ts": "../src/runtime/ssr-client/lit-element-hydrate-support.ts",
    "@limette/core/runtime/ssr-client/lit-element-hydrate-support-patch.ts": "../src/runtime/ssr-client/lit-element-hydrate-support-patch.ts",
    "@lit-labs/ssr": "npm:@lit-labs/ssr@3.3.0",
    "@lit-labs/ssr/": "npm:/@lit-labs/ssr@3.3.0/",
    "@lit-labs/ssr-client": "npm:@lit-labs/ssr-client@1.1.7",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1",
    "@std/cli": "jsr:@std/cli@1.0.11",
    "@std/encoding": "jsr:@std/encoding@1.0.6",
    "@std/fmt": "jsr:@std/fmt@1.0.4",
    "@std/fs": "jsr:@std/fs@1.0.10",
    "@std/http": "jsr:@std/http@1.0.12",
    "@std/path": "jsr:@std/path@1.0.8",
    "/lit": "npm:/lit@^3.2.1/",
    "esbuild": "npm:esbuild@0.24.2",
    "lit": "npm:lit@^3.2.1",
    "parse-imports": "npm:parse-imports@2.2.1",
    "tailwindcss": "npm:tailwindcss@4.3.1",
    "vite": "npm:vite@^8.0.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "fmt": {
    "singleQuote": true
  },
  "lock": false,
  "links": ["../"]
}
