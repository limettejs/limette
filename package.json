{
  "name": "@limette/core",
  "version": "0.2.3",
  "description": "A full-stack framework for Lit Web Components.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://limette.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limettejs/limette.git"
  },
  "bugs": {
    "url": "https://github.com/limettejs/limette/issues"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./deno": {
      "types": "./dist/deno.d.mts",
      "default": "./dist/deno.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./runtime/refresh": {
      "types": "./dist/runtime/refresh.d.mts",
      "default": "./dist/runtime/refresh.mjs"
    },
    "./runtime/refresh.ts": {
      "types": "./dist/runtime/refresh.d.mts",
      "default": "./dist/runtime/refresh.mjs"
    },
    "./runtime/ssr-client/lit-element-hydrate-support": {
      "types": "./dist/runtime/ssr-client/lit-element-hydrate-support.d.mts",
      "default": "./dist/runtime/ssr-client/lit-element-hydrate-support.mjs"
    },
    "./runtime/ssr-client/lit-element-hydrate-support.ts": {
      "types": "./dist/runtime/ssr-client/lit-element-hydrate-support.d.mts",
      "default": "./dist/runtime/ssr-client/lit-element-hydrate-support.mjs"
    },
    "./runtime/ssr-client/lit-element-hydrate-support-patch": {
      "types": "./dist/runtime/ssr-client/lit-element-hydrate-support-patch.d.mts",
      "default": "./dist/runtime/ssr-client/lit-element-hydrate-support-patch.mjs"
    },
    "./runtime/ssr-client/lit-element-hydrate-support-patch.ts": {
      "types": "./dist/runtime/ssr-client/lit-element-hydrate-support-patch.d.mts",
      "default": "./dist/runtime/ssr-client/lit-element-hydrate-support-patch.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "lit": "^3.2.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@lit-labs/ssr": "3.3.0",
    "@lit-labs/ssr-client": "1.1.7",
    "linkedom": "0.18.12",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
